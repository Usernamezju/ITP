# Copy this file to .env. All cloud connection fields are intentionally empty.
# Operator-only configuration: clients never enter model/payment credentials.
# Set these on the server and restart itp-api after changing them. Preserve the
# existing .env when deploying; never copy this example over live credentials.
# Tencent mainland AI3D: endpoint is a hostname, without https:// or a path.
ITP_TENCENT_ENDPOINT=
ITP_TENCENT_SECRET_ID=
ITP_TENCENT_SECRET_KEY=
ITP_TENCENT_REGION=
ITP_TENCENT_MODEL=3.1

# Qwen mainland Model Studio: full multimodal-generation/generation HTTPS URL.
ITP_POSE_ENDPOINT=
ITP_POSE_API_KEY=
ITP_POSE_MODEL=qwen-image-edit-plus-2025-12-15

# Try-on providers. Set endpoint and API key only for models you plan to use.
ITP_SEEDREAM_ENDPOINT=
ITP_SEEDREAM_API_KEY=
ITP_SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915
ITP_FLUX_ENDPOINT=
ITP_FLUX_API_KEY=
ITP_FLUX_MODEL=flux-2-pro
ITP_FLUX_MAX_ENDPOINT=
ITP_FLUX_MAX_API_KEY=
ITP_FLUX_MAX_MODEL=flux-2-max
ITP_FLUX_KLEIN_ENDPOINT=
ITP_FLUX_KLEIN_API_KEY=
ITP_FLUX_KLEIN_MODEL=flux.2-klein-4b
ITP_FLUX_KLEIN_9B_ENDPOINT=
ITP_FLUX_KLEIN_9B_API_KEY=
ITP_FLUX_KLEIN_9B_MODEL=flux.2-klein-9b
ITP_GPT_IMAGE_ENDPOINT=
ITP_GPT_IMAGE_API_KEY=
ITP_GPT_IMAGE_MODEL=gpt-image-2

# Outfit photo search. The default provider "so" (360 图片) needs no key and is
# the only one verified live. "unsplash" and "pixabay" are implemented against
# their official APIs but were not verified without a key; when the selected
# provider has no key the service quietly falls back to "so".
# Product-image understanding for the merchant console.  Any OpenAI-compatible
# vision chat endpoint works (Ark Seed chat models use /api/v3/chat/completions);
# the key falls back to ITP_POSE_API_KEY when left empty.
ITP_PRODUCT_AI_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
ITP_PRODUCT_AI_MODEL=qwen-vl-max
ITP_PRODUCT_AI_API_KEY=
ITP_IMAGE_PROVIDER=so
ITP_UNSPLASH_ACCESS_KEY=
ITP_PIXABAY_API_KEY=

# Unified customer/merchant accounts reuse the existing scrypt/JWT system.
# Leave ITP_JWT_SECRET empty and the service generates a
# 64-character hex secret on the first login request, writing it here with
# owner-only permissions; public deployments fail login if it cannot persist.
# ITP_MERCHANT_TOKEN_HOURS is the shared login lifetime (legacy variable name).
# ITP_MERCHANT_QUOTA is a retired legacy product-count field, not an upload limit.
ITP_JWT_SECRET=
ITP_MERCHANT_TOKEN_HOURS=12
ITP_MERCHANT_QUOTA=200

# Platform prices use INTEGER CENTS, never yuan floats. Restart the API to apply.
ITP_MODEL_PRICE_CENTS=1500
ITP_CUSTOMER_MEMBERSHIP_PRICE_CENTS=3000
ITP_MERCHANT_FREE_UPLOAD_LIMIT=5
ITP_MERCHANT_FREE_PERIOD_MONTHS=1
# Optional paid merchant tiers; prices are operator decisions, no defaults invented.
# JSON array fields: id, name, audience="merchant", price_cents, period_months,
# entitlements={"garment_upload": integer}, active, purchasable.
ITP_COMMERCIAL_PLANS=[]

# Unified payments: production never enables a fallback mock provider.
# These are OPERATOR settings, never customer browser fields. Preserve live .env.
# The merchant credential fields below can also be set from /admin → 支付配置, which
# writes them here atomically and reloads the channels without a restart.
ITP_ENVIRONMENT=production
ITP_PAYMENT_MOCK_ENABLED=false
ITP_PAYMENT_MOCK_SECRET=
# Bare HTTPS origin; defaults to ITP_PUBLIC_ORIGIN when omitted.
ITP_PAYMENT_NOTIFY_ORIGIN=
ITP_ALIPAY_APP_ID=
ITP_ALIPAY_SELLER_ID=
# RSA PEM values may use escaped \\n inside a quoted .env value.
ITP_ALIPAY_PRIVATE_KEY=
ITP_ALIPAY_PUBLIC_KEY=
ITP_WECHAT_APP_ID=
ITP_WECHAT_MCH_ID=
ITP_WECHAT_MERCHANT_SERIAL=
ITP_WECHAT_PRIVATE_KEY=
ITP_WECHAT_API_V3_KEY=
# JSON object of trusted platform certificate serial/public-key ID -> PEM.
ITP_WECHAT_PLATFORM_KEYS={}

# Local files are excluded from Git.
ITP_DATA_DIR=./data
ITP_SEGMENTATION_MODEL=./models/u2netp.onnx
ITP_POLL_SECONDS=5
ITP_TASK_TIMEOUT_SECONDS=3600
