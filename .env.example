# Copy this file to .env. All cloud connection fields are intentionally empty.
# Tencent mainland AI3D: endpoint is a hostname, without https:// or a path.
ITP_TENCENT_ENDPOINT=
ITP_TENCENT_SECRET_ID=
ITP_TENCENT_SECRET_KEY=
ITP_TENCENT_REGION=
ITP_TENCENT_MODEL=3.1

# Qwen mainland Model Studio: full multimodal-generation/generation HTTPS URL.
ITP_POSE_ENDPOINT=
ITP_POSE_API_KEY=
ITP_POSE_MODEL=qwen-image-edit-plus-2025-12-15

# Try-on providers. Set endpoint and API key only for models you plan to use.
ITP_SEEDREAM_ENDPOINT=
ITP_SEEDREAM_API_KEY=
ITP_SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915
ITP_FLUX_ENDPOINT=
ITP_FLUX_API_KEY=
ITP_FLUX_MODEL=flux-2-pro
ITP_FLUX_MAX_ENDPOINT=
ITP_FLUX_MAX_API_KEY=
ITP_FLUX_MAX_MODEL=flux-2-max
ITP_FLUX_KLEIN_ENDPOINT=
ITP_FLUX_KLEIN_API_KEY=
ITP_FLUX_KLEIN_MODEL=flux.2-klein-4b
ITP_FLUX_KLEIN_9B_ENDPOINT=
ITP_FLUX_KLEIN_9B_API_KEY=
ITP_FLUX_KLEIN_9B_MODEL=flux.2-klein-9b
ITP_GPT_IMAGE_ENDPOINT=
ITP_GPT_IMAGE_API_KEY=
ITP_GPT_IMAGE_MODEL=gpt-image-2

# Outfit photo search. The default provider "so" (360 图片) needs no key and is
# the only one verified live. "unsplash" and "pixabay" are implemented against
# their official APIs but were not verified without a key; when the selected
# provider has no key the service quietly falls back to "so".
ITP_IMAGE_PROVIDER=so
ITP_UNSPLASH_ACCESS_KEY=
ITP_PIXABAY_API_KEY=

# Merchant accounts. Leave ITP_JWT_SECRET empty and the service generates a
# 64-character hex secret on the first merchant request, writing it here with
# owner-only permissions; tokens signed with it stay valid until it changes.
# ITP_MERCHANT_TOKEN_HOURS is the login lifetime, ITP_MERCHANT_QUOTA the number
# of garments one merchant may publish.
ITP_JWT_SECRET=
ITP_MERCHANT_TOKEN_HOURS=12
ITP_MERCHANT_QUOTA=200

# Local files are excluded from Git.
ITP_DATA_DIR=./data
ITP_SEGMENTATION_MODEL=./models/u2netp.onnx
ITP_POLL_SECONDS=5
ITP_TASK_TIMEOUT_SECONDS=3600
